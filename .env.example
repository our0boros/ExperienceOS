# LLM Backend: "ollama" for local testing, "deepinfra" for production
EOS_LLM_BACKEND=ollama

# Ollama settings (OpenAI-compatible endpoint)
EOS_OLLAMA_BASE_URL=http://localhost:11434/v1
EOS_OLLAMA_MODEL=qwen2.5:7b
EOS_OLLAMA_API_KEY=ollama

# DeepInfra settings (OpenAI-compatible endpoint)
EOS_DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
EOS_DEEPINFRA_MODEL=MiniMaxAI/MiniMax-M2.7
# DEEPINFRA_TOKEN env var is read directly

# Embedding model (use ollama local embeddings)
EOS_EMBEDDING_MODEL=qwen2.5:7b
EOS_EMBEDDING_DIM=3584

# Induction thresholds
EOS_MIN_SUPPORT=3
EOS_VALIDATION_THRESHOLD=0.8
